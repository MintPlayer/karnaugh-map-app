{
  "name": "ng-karnaugh-map",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mintplayer/ng-karnaugh-map/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:mintplayer"],
  "implicitDependencies": ["quine-mccluskey"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": ["quine-mccluskey:build"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/mintplayer/ng-karnaugh-map/ng-package.json",
        "tsConfig": "libs/mintplayer/ng-karnaugh-map/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/mintplayer/ng-karnaugh-map/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
